# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# YOUR Claude API key — the whole point of the backend is to keep this secret,
# server-side, so users never need their own.
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for extraction.
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Stripe (Phase 2). Create two recurring Prices in your Stripe dashboard.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_PLATINUM=price_...

# Where the app is hosted (for CORS + Stripe redirect URLs).
APP_URL=https://bmfogle-star.github.io/base/

# Server port.
PORT=8080

# SQLite database file.
DATABASE_FILE=./spark.db
