# Shared secret — the app must send this as "Authorization: Bearer <token>".
BOT_API_TOKEN=change-me-to-a-long-random-string

# Port the server listens on.
PORT=4000

# Where to store recordings on disk.
RECORDINGS_DIR=./recordings

# Hard cap on meeting length (ms). Default 90 minutes.
MAX_DURATION_MS=5400000

# Optional: path to a Chrome/Chromium binary if not using Puppeteer's bundled one.
# CHROME_PATH=/usr/bin/google-chrome

# Optional: path to a whisper.cpp build for FREE on-server transcription.
# If unset, the server returns the audio and the app transcribes it (also free, in-browser).
# WHISPER_CPP_PATH=/opt/whisper.cpp/main
